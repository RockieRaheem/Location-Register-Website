rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return hasProfile() && profile().status == 'active';
    }

    function admin() {
      return verified() && activeUser() && profile().role == 'admin';
    }

    function countryManager(countryCode) {
      return verified() && activeUser() && (
        profile().role == 'admin' ||
        (profile().role == 'country_admin' && profile().assignedCountryCodes.hasAny([countryCode]))
      );
    }

    function countryContributor(countryCode) {
      return verified() && activeUser() && (
        profile().role == 'admin' ||
        ((profile().role == 'country_admin' || profile().role == 'contributor') &&
          profile().assignedCountryCodes.hasAny([countryCode]))
      );
    }

    function validIdentifier(value) {
      return value is string && value.size() > 0 && value.size() <= 128 && value.matches('^[A-Za-z0-9_-]+$');
    }

    function validUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'status', 'assignedCountryCodes']) &&
        data.keys().hasOnly(['uid', 'email', 'name', 'avatar', 'role', 'status', 'assignedCountryCodes', 'bio', 'gender', 'dateOfBirth', 'idType', 'idNumber', 'idDocument', 'selfie', 'createdAt', 'updatedAt']) &&
        data.uid == userId && data.email is string && data.email.size() <= 254 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        (data.avatar == null || (data.avatar is string && data.avatar.size() <= 2000)) &&
        data.role in ['admin', 'country_admin', 'contributor', 'developer', 'manufacturer', 'financial_institution'] &&
        data.status in ['active', 'disabled'] && data.assignedCountryCodes is list && data.assignedCountryCodes.size() <= 60;
    }

    function validCountry(data, countryCode) {
      return data.keys().hasAll(['uid', 'code', 'name', 'rootLocationUid', 'schemaVersion']) &&
        data.uid is string && data.code == countryCode && countryCode.matches('^[A-Z]{2}$') &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.rootLocationUid is string && data.schemaVersion is int && data.schemaVersion > 0;
    }

    function validLevel(data) {
      return data.keys().hasAll(['uid', 'countryUid', 'order', 'key', 'name', 'alternateNames', 'allowedTypes', 'required']) &&
        data.uid is string && data.countryUid is string && data.order is int && data.order > 0 && data.order <= 20 &&
        data.key is string && data.key.matches('^[a-z][a-z0-9_]{0,49}$') &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.alternateNames is list && data.alternateNames.size() <= 20 &&
        data.allowedTypes is list && data.allowedTypes.size() <= 30 && data.required is bool;
    }

    function validLocation(data, locationId) {
      return data.keys().hasAll(['uid', 'referenceCode', 'countryUid', 'countryCode', 'levelOrder', 'levelKey', 'levelName', 'parentUid', 'ancestorUids', 'name', 'normalizedName', 'type', 'status', 'metadata']) &&
        data.uid == locationId && data.countryUid is string && data.countryCode.matches('^[A-Z]{2}$') &&
        data.referenceCode is string && data.referenceCode.matches('^[A-Z]{2}-L[0-9]{2}-[A-F0-9]{32}$') &&
        (data.levelUid == null || data.levelUid is string) && data.levelOrder is int && data.levelOrder >= 0 && data.levelOrder <= 20 &&
        data.levelKey is string && data.levelName is string &&
        (data.parentUid == null || data.parentUid is string) && data.ancestorUids is list && data.ancestorUids.size() <= 20 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.normalizedName is string && data.normalizedName.size() > 0 && data.normalizedName.size() <= 250 &&
        data.type is string && data.type.size() > 0 && data.type.size() <= 100 &&
        data.status in ['active', 'inactive', 'historical'] && data.metadata is map;
    }

    function validLocationLevel(data) {
      return data.levelUid is string &&
        exists(/databases/$(database)/documents/countries/$(data.countryCode)/hierarchyLevels/$(data.levelUid)) &&
        get(/databases/$(database)/documents/countries/$(data.countryCode)/hierarchyLevels/$(data.levelUid)).data.countryUid == data.countryUid &&
        get(/databases/$(database)/documents/countries/$(data.countryCode)/hierarchyLevels/$(data.levelUid)).data.order == data.levelOrder &&
        get(/databases/$(database)/documents/countries/$(data.countryCode)/hierarchyLevels/$(data.levelUid)).data.key == data.levelKey &&
        get(/databases/$(database)/documents/countries/$(data.countryCode)/hierarchyLevels/$(data.levelUid)).data.name == data.levelName;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || admin());
      allow list, delete: if admin();
      allow create: if signedIn() && request.auth.uid == userId && validUser(request.resource.data, userId) &&
        request.resource.data.email == request.auth.token.email && request.resource.data.role == 'contributor' &&
        request.resource.data.status == 'active' && request.resource.data.assignedCountryCodes.size() == 0;
      allow update: if validUser(request.resource.data, userId) && (
        (admin() && request.resource.data.uid == resource.data.uid && request.resource.data.email == resource.data.email) ||
        (signedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'bio', 'gender', 'dateOfBirth', 'idType', 'idNumber', 'idDocument', 'selfie', 'updatedAt']))
      );
    }

    match /countries/{countryCode} {
      allow read: if activeUser();
      allow create, update: if admin() && validCountry(request.resource.data, countryCode);
      allow delete: if false;

      match /hierarchyLevels/{levelId} {
        allow read: if activeUser();
        allow create, update: if admin() && validIdentifier(levelId) && validLevel(request.resource.data);
        allow delete: if false;
      }
    }

    match /locations/{locationId} {
      allow read: if activeUser();
      // All mutations go through the authenticated API. Admin SDK imports bypass rules,
      // preserving global reference-code uniqueness and atomic subtree operations.
      allow create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if activeUser();
      allow write: if verified() && activeUser();
    }

    match /stock/{stockId} {
      allow read: if activeUser();
      allow write: if verified() && activeUser();
    }

    match /regionalEconomicLevels/{levelId} {
      allow read: if activeUser();
      allow write: if admin();
    }

    match /shops/{shopId} {
      allow read: if activeUser();
      allow create: if verified() && activeUser();
      allow update: if admin() || (verified() && activeUser() && resource.data.ownerId == request.auth.uid);
      allow delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
