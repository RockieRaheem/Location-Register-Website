# Firebase Console > Project settings > General > Your apps > Web SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=any-location-36e76.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=any-location-36e76
VITE_FIREBASE_STORAGE_BUCKET=any-location-36e76.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Leave as (default) unless you deliberately created a named Firestore database.
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_STORAGE_ENABLED=false

# Server-side import/deployment only; never prefix these with VITE_ or expose them to the browser.
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\path\service-account.json
# FIREBASE_PROJECT_ID=any-location-36e76
# FIREBASE_CHECK_REVOKED_TOKENS=false
# Comma-separated verified emails allowed to grant and revoke roles in the owner UI.
OWNER_EMAILS=owner@example.com
# GOOGLE_APPLICATION_CREDENTIALS is required for role assignment and Firebase imports.
# API requests use short-lived Firebase ID tokens; never place service-account keys in this repository.
