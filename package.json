{
  "name": "any-location",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "vite build",
    "db:seed": "tsx scripts/database/seed-location-database.ts",
    "db:validate": "tsx scripts/database/validate-location-database.ts",
    "db:enrich:uganda-geodata": "tsx scripts/geospatial/enrich-uganda-geodata.ts",
    "firebase:import:locations": "tsx scripts/firebase/import-locations-to-firestore.ts",
    "firebase:set-role": "tsx scripts/firebase/set-firebase-user-role.ts",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "validate:ec-2022": "node scripts/data/validate-electoral-commission-2022.cjs",
    "validate:uganda-support": "node scripts/data/validate-uganda-support.cjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:rules": "firebase emulators:exec --only firestore \"npm test -- --runInBand\"",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint firebase/firestore.rules firebase/storage.rules"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "firebase": "^12.11.0",
    "lucide-react": "^0.477.0",
    "motion": "^12.35.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.8",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.3.0",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.29.0",
    "jest": "^30.3.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
